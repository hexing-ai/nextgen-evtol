{
  "name": "nextgen-evtol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node backend/src/server.mjs",
    "test": "node --test backend/test/*.test.mjs",
    "check:data": "node scripts/check-data.mjs",
    "export:static": "node scripts/export-static.mjs",
    "check": "npm run check:data && npm test && npm run build",
    "dev": "node scripts/prepare-assets.mjs && vite",
    "build": "node scripts/prepare-assets.mjs && vite build && npm run export:static",
    "preview": "vite preview",
    "assets:aircraft": "node scripts/create-aircraft.mjs"
  },
  "dependencies": {
    "cesium": "^1.146.0",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resium": "^1.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "pngjs": "^7.0.0",
    "vite": "^8.3.2"
  }
}
